import sys

def is_divisible_by_64(s):
    # Convert the binary string to an integer
    num = int(s, 2)
    
    # Check if the number is divisible by 64
    return num % 64 == 0

# Read input from standard input
s = sys.stdin.read().strip()

# Check if the remaining number is divisible by 64
if is_divisible_by_64(s):
    print("yes")
else:
    print("no")