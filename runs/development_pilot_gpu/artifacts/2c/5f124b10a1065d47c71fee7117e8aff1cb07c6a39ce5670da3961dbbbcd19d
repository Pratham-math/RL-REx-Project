import sys

def is_divisible_by_64(binary_str):
    for i in range(len(binary_str), -1, -1):
        for j in range(i + 1):
            candidate = int(binary_str[:j] + binary_str[j + 1:i] + binary_str[i + 1:], 2)
            if candidate % 64 == 0:
                return True
    return False

def main():
    binary_str = input().strip()
    if is_divisible_by_64(binary_str):
        print("yes")
    else:
        print("no")

if __name__ == "__main__":
    main()