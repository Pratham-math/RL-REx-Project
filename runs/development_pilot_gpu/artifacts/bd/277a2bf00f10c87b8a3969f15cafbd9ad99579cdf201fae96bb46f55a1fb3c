n, k = map(int, input().split())
tabs = list(map(int, input().split()))

max_diff = 0
for b in range(1, n+1):
    remaining_test = 0
    remaining_social = 0
    for i in range(n):
        c = (b + i * k - 1) % n
        if tabs[c] == 1:
            remaining_test += 1
        else:
            remaining_social += 1
    max_diff = max(max_diff, abs(remaining_test - remaining_social))

print(max_diff)