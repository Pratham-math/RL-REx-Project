# Read input from standard input
n, k = map(int, input().split())
line = input().strip()

# Find the starting position of the grasshopper and the target insect
start = line.find('G')
target = line.find('T')

# Initialize a list to keep track of visited cells
visited = [False] * n

# Initialize a list to keep track of the cells that can be reached from the starting position
queue = [start]

# Perform a breadth-first search (BFS) to check if the grasshopper can reach the insect
while queue:
    current = queue.pop(0)
    visited[current] = True

    # Check the cell k positions to the left
    if current - k >= 0 and line[current - k] != '#' and not visited[current - k]:
        queue.append(current - k)

    # Check the cell k positions to the right
    if current + k < n and line[current + k] != '#' and not visited[current + k]:
        queue.append(current + k)

# Check if the target insect is reachable
if visited[target]:
    print("YES")
else:
    print("NO")