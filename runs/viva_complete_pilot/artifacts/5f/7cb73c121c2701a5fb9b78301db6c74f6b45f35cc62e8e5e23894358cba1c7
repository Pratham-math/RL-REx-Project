def can_reach_all(n, m, horizontal, vertical):
    # Check horizontal streets
    for i in range(n):
        if horizontal[i] == '<':
            if i > 0 and horizontal[i-1] != '>':
                return False
        else:
            if i > 0 and horizontal[i-1] != '<':
                return False
    
    # Check vertical streets
    for i in range(m):
        if vertical[i] == '^':
            if i > 0 and vertical[i-1] != 'v':
                return False
        else:
            if i > 0 and vertical[i-1] != '^':
                return False
    
    return True

def main():
    import sys
    input = sys.stdin.read
    data = input().split()
    
    n = int(data[0])
    m = int(data[1])
    horizontal = data[2]
    vertical = data[3]
    
    if can_reach_all(n, m, horizontal, vertical):
        print("YES")
    else:
        print("NO")

if __name__ == "__main__":
    main()