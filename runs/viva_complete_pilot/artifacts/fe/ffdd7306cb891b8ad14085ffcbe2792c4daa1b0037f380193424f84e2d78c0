def can_grasshopper_reach_insect(n, k, line):
    G_index = line.find('G')
    T_index = line.find('T')
    
    if abs(G_index - T_index) % k == 0:
        return "YES"
    else:
        return "NO"

# Read input
n, k = map(int, input().split())
line = input().strip()

# Write output
print(can_grasshopper_reach_insect(n, k, line))