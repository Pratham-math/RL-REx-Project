def is_divisible_by_64(s):
    for i in range(len(s)):
        for j in range(i + 1, len(s) + 1):
            num = int(s[i:j], 2)
            if num % 64 == 0 and num != 0:
                return True
    return False

s = input().strip()
if is_divisible_by_64(s):
    print('yes')
else:
    print('no')